
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#6d28d9">
<meta name="description" content="حلّ لي مشكلتي: رتّب أفكارك واكتشف خطوات عملية للبدء.">
<title>حلّ لي مشكلتي | كل مشكلة لها بداية حلّ</title>

<style>
:root {
  --purple: #6d28d9;
  --pink: #ec4899;
  --blue: #2563eb;
  --ink: #24213b;
  --muted: #706d83;
  --line: #e9e3f5;
  --bg: #f8f6ff;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: Tahoma, Arial, sans-serif;
  color: var(--ink);
  background: linear-gradient(180deg,#f0e8ff,#fbfaff 380px,#fff);
  line-height: 1.8;
}
button,input,textarea,select { font: inherit; }
button { cursor: pointer; }
.container { width: min(1050px,94%); margin: auto; }
header {
  display:flex; align-items:center; justify-content:space-between;
  gap:12px; padding:16px 0;
}
.brand { display:flex; align-items:center; gap:10px; font-weight:bold; }
.logo {
  display:grid; place-items:center; width:46px; height:46px;
  border-radius:15px; color:#fff; font-size:25px;
  background:linear-gradient(135deg,var(--purple),var(--pink));
}
.tag { font-size:12px; background:#fff; border:1px solid var(--line);
  padding:6px 11px; border-radius:30px; }
.hero { text-align:center; padding:35px 10px 40px; }
.eyebrow { color:var(--purple); font-weight:bold; }
h1 { font-size:clamp(34px,6vw,55px); line-height:1.35; margin:12px 0; }
.gradient {
  color:var(--purple);
  background:linear-gradient(90deg,var(--purple),var(--pink),var(--blue));
  background-clip:text; -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}
.hero p { max-width:650px; margin:10px auto 22px; color:var(--muted); }
.card {
  background:#fff; border:1px solid var(--line); border-radius:22px;
  padding:clamp(17px,4vw,28px); margin:18px 0;
  box-shadow:0 12px 35px #39216d0a;
}
h2 { font-size:21px; margin:0 0 5px; }
.subtitle { color:var(--muted); font-size:13px; margin:0 0 20px; }
.categories { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
.category {
  background:#fff; color:var(--ink); border:1px solid var(--line);
  border-radius:15px; padding:12px 5px; text-align:center;
}
.category span { display:block; font-size:27px; }
.category strong { font-size:12px; }
.category.active { border:2px solid var(--purple); background:#f4efff; color:var(--purple); }
label { display:block; font-weight:bold; font-size:14px; margin:15px 0 7px; }
textarea,input,select {
  width:100%; padding:12px; border:1px solid #ddd7eb; border-radius:12px;
  background:#fff; color:var(--ink); outline:none;
}
textarea { min-height:120px; resize:vertical; }
textarea:focus,input:focus,select:focus {
  border-color:var(--purple); box-shadow:0 0 0 3px #6d28d915;
}
.grid2 { display:grid; grid-template-columns:1fr 1fr; gap:15px; }
.btn {
  border:0; border-radius:12px; padding:12px 18px; font-weight:bold;
}
.primary { color:white; background:linear-gradient(110deg,var(--purple),var(--pink)); }
.secondary { color:var(--purple); background:#f1ebff; border:1px solid #e4d9ff; }
.actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:18px; }
.hint { color:var(--muted); font-size:12px; }
.result { display:none; }
.result.show { display:block; }
.result-banner {
  background:linear-gradient(110deg,#f0e9ff,#fff0f7);
  padding:18px; border-radius:16px; margin-bottom:18px;
}
.result-banner h3 { margin:0 0 5px; }
.result-banner p { margin:0; }
.result-block { border-bottom:1px solid var(--line); padding:15px 0; }
.result-block:last-of-type { border-bottom:0; }
.result-block h3 { font-size:17px; margin:0 0 8px; }
.steps { padding:0; list-style:none; margin:0; }
.steps li { display:flex; align-items:flex-start; gap:10px; padding:7px 0; }
.num {
  display:grid; place-items:center; flex-shrink:0; width:28px; height:28px;
  border-radius:9px; background:#eee7ff; color:var(--purple); font-weight:bold;
}
.question { background:#eff6ff; border-radius:14px; padding:15px; margin-top:16px; }
.notice { background:#fff8e7; padding:13px; border-radius:12px; font-size:12px; margin-top:17px; }
#status { color:var(--purple); font-size:13px; margin-top:10px; }
footer { text-align:center; padding:28px 0; color:var(--muted); font-size:12px; }
@media(max-width:600px) {
  .container { width:92%; }
  .grid2 { grid-template-columns:1fr; gap:0; }
  .categories { gap:7px; }
  .category { padding:10px 3px; }
  .category strong { font-size:11px; }
  .hero { padding-top:25px; }
}
</style>
</head>

<body>
<header class="container">
  <div class="brand"><div class="logo">💡</div><span>حلّ لي مشكلتي</span></div>
  <span class="tag">الإصدار التجريبي 1.0</span>
</header>

<main class="container">
  <section class="hero">
