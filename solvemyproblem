      <button class="category" data-cat="faith" aria-pressed="false"><span>✨</span><strong>القيم والمعنى</strong></button>
    </div>
  </section>

  <section class="card" id="inputCard">
    <h2>٢. احكِ لنا عن مشكلتك</h2>
    <p class="subtitle">اكتب بطريقتك. لا تحتاج إلى صياغة مثالية.</p>

    <form id="problemForm">
      <label for="problem">ما المشكلة التي تريد حلّها؟ *</label>
      <textarea id="problem" required maxlength="3000"
        placeholder="مثال: عندي أفكار مشروعات كثيرة، لكنني مشتت ولا أعرف أيها أبدأ به..."></textarea>

      <div class="grid2">
        <div>
          <label for="goal">ما النتيجة التي تتمناها؟</label>
          <input id="goal" maxlength="500" placeholder="مثال: أبدأ مشروعًا صغيرًا">
        </div>
        <div>
          <label for="time">متى تريد التقدم؟</label>
          <select id="time">
            <option>اليوم</option>
            <option selected>خلال أسبوع</option>
            <option>خلال شهر</option>
            <option>على المدى الطويل</option>
          </select>
        </div>
      </div>

      <label for="limits">ما الذي يعيقك؟ (اختياري)</label>
      <input id="limits" maxlength="500" placeholder="مثال: الوقت أو الميزانية أو الخبرة">

      <div class="actions">
        <button class="btn primary" type="submit">✨ اقترح خطوات للحل</button>
        <button class="btn secondary" id="clearBtn" type="button">مسح البيانات</button>
      </div>
      <p class="hint">لا تكتب كلمات المرور أو بياناتك البنكية أو معلومات شخصية حساسة.</p>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
  </section>

  <section class="card result" id="result" aria-live="polite">
    <h2>٣. خريطة بداية الحل</h2>
    <p class="subtitle">خطة مبدئية يمكنك تعديلها حسب ظروفك.</p>

    <div class="result-banner">
      <h3 id="resultTitle">خطوة صغيرة تصنع فرقًا</h3>
      <p id="summary"></p>
    </div>

    <div class="result-block">
      <h3>🔎 فهم المشكلة</h3>
      <p id="problemSummary"></p>
    </div>

    <div class="result-block">
      <h3>🛠️ خطوات عملية مقترحة</h3>
      <ol class="steps" id="steps"></ol>
    </div>

    <div class="result-block">
      <h3>🎯 خطوتك التالية</h3>
      <p id="nextStep"></p>
    </div>

    <div class="question">
      <strong>💭 سؤال يساعد على تحسين الحل</strong>
      <p id="followup"></p>
    </div>

    <div class="notice">
      <strong>توضيح:</strong> هذه نسخة تجريبية تستخدم قواعد محلية داخل الصفحة،
      وليست متصلة حاليًا بنموذج ذكاء اصطناعي خارجي. راجع الاقتراحات قبل اتخاذ
      قرارات مالية أو صحية أو قانونية مهمة.
    </div>

    <div class="actions">
      <button class="btn primary" id="copyBtn" type="button">📋 نسخ خطة الحل</button>
      <button class="btn secondary" id="editBtn" type="button">✏️ تعديل المشكلة</button>
      <button class="btn secondary" id="newBtn" type="button">↻ مشكلة جديدة</button>
    </div>
  </section>
</main>

<footer class="container">
  <strong>حلّ لي مشكلتي © 2026</strong><br>
  من الحيرة إلى الفهم، ومن الفهم إلى خطوة عملية.
</footer>

