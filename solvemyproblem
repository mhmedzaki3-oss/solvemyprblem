      <button class="category active" data-cat="general" aria-pressed="true"><span>🧩</span><strong>مشكلة عامة</strong></button>
      <button class="category" data-cat="work" aria-pressed="false"><span>💼</span><strong>العمل والدخل</strong></button>
      <button class="category" data-cat="education" aria-pressed="false"><span>📚</span><strong>التعليم</strong></button>
      <button class="category" data-cat="family" aria-pressed="false"><span>🏡</span><strong>الأسرة والعلاقات</strong></button>
