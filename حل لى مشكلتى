      "اكتب ثلاثة حلول محتملة وقارن بينها.",
      "اختر خطوة صغيرة وآمنة يمكنك تنفيذها خلال 24 ساعة.",
      "راجع النتيجة وعدّل خطتك بناءً على ما تعلمته."
    ],
    question:"ما أكثر جزء يزعجك الآن، وما الشيء الذي تستطيع تغييره بنفسك؟"
  },
  work: {
    title:"حوّل تحدي العمل إلى خطة قابلة للتنفيذ",
    steps:[
      "حدّد هدفك: وظيفة، دخل إضافي، مهارة جديدة، أم مشروع.",
      "اكتب الموارد المتاحة لديك من وقت ومهارات وميزانية.",
      "اختر أولوية واحدة بدل توزيع الجهد على أهداف كثيرة.",
      "نفّذ تجربة صغيرة منخفضة التكلفة وحدّد طريقة قياسها.",
      "راجع النتائج قبل اتخاذ قرار مالي أو مهني كبير."
    ],
    question:"ما المهارة أو المورد المتاح لديك الآن، وما أصغر تجربة يمكنك البدء بها؟"
  },
  education: {
    title:"اجعل التعلّم أكثر تنظيمًا",
    steps:[
      "حدّد ما تريد تعلمه ولماذا تحتاج إليه.",
      "قسّم الموضوع إلى أجزاء صغيرة مرتبة.",
      "خصص وقتًا واقعيًا للتعلم والتطبيق.",
      "اختبر فهمك بمثال عملي أو تمرين.",
      "راجع تقدمك أسبوعيًا وحدد نقطة التحسين التالية."
    ],
    question:"ما الموضوع الذي تتعلمه، وكم دقيقة تستطيع تخصيصها يوميًا؟"
  },
  family: {
    title:"ابدأ بالفهم والتواصل الهادئ",
    steps:[
      "صف الموقف المحدد الذي يسبب الخلاف دون تعميم.",
      "فرّق بين ما حدث وبين تفسيرك لنية الطرف الآخر.",
      "اختر وقتًا مناسبًا وآمنًا للحوار.",
      "عبّر عن احتياجك بوضوح واستمع للطرف الآخر.",
      "اتفقوا على خطوة صغيرة قابلة للتجربة."
    ],
    question:"ما التغيير الصغير الذي تتمنى حدوثه، وهل الحوار آمن في هذه العلاقة؟"
  },
  innovation: {
    title:"اختبر فكرتك قبل إنفاق الكثير",
    steps:[
      "اكتب المشكلة التي تحلها فكرتك ومن يعاني منها.",
      "تحدث مع أشخاص من الفئة المستهدفة لفهم احتياجاتهم.",
      "أنشئ أبسط نموذج يوضح الفكرة.",
      "اطلب تجربة النموذج واجمع الملاحظات.",
      "حسّن الفكرة بناءً على الأدلة قبل التوسع."
    ],
    question:"من أول شخص يمكنه تجربة فكرتك، وما أبسط نموذج تستطيع تقديمه؟"
  },
  daily: {
    title:"استعد السيطرة على أولوياتك",
    steps:[
      "اكتب المهام التي تشغل بالك في قائمة واحدة.",
      "اختر أهم ثلاث مهام وفق الأثر والموعد النهائي.",
      "قسّم أكبر مهمة إلى خطوات قصيرة.",
      "حدد وقتًا للعمل وقلل المشتتات.",
      "راجع إنجازات اليوم وحدد أول مهمة للغد."
    ],
    question:"ما المهمة الواحدة التي سيجعل إنجازها يومك أفضل؟"
  },
  wellbeing: {
    title:"ابدأ بخطوة تدعم راحتك",
    steps:[
      "توقف قليلًا وسمّ الشعور أو الضغط الذي تواجهه.",
      "فرّق بين الأمور التي تستطيع تغييرها وتلك الخارجة عن سيطرتك.",
      "اختر خطوة صغيرة تناسب طاقتك وظروفك.",
      "تحدث مع شخص موثوق إذا احتجت إلى دعم.",
      "إذا استمر الضيق أو أثر في حياتك، فاطلب مساعدة مختص مناسب."
    ],
    question:"ما أكثر شيء يستنزف طاقتك حاليًا، وما نوع الدعم الذي قد يفيدك؟"
  },
  community: {
    title:"ابدأ بحل مجتمعي صغير قابل للقياس",
    steps:[
      "حدد المشكلة والفئة الأكثر تأثرًا بها.",
      "استمع إلى أصحاب التجربة واجمع معلومات موثوقة.",
      "اختر حلًا أوليًا واقعيًا ضمن الموارد المتاحة.",
      "جرّب الحل على نطاق صغير بالتعاون مع المعنيين.",
      "قِس الأثر وتعلّم قبل التفكير في التوسع."
    ],
    question:"من الأكثر تأثرًا بالمشكلة، ومن يمكنه التعاون معك؟"
  },
  faith: {
    title:"وازن بين القيم والعمل والتفكير",
    steps:[
      "حدد القيم التي تريد أن توجه قرارك.",
      "اكتب الخيارات المتاحة وما يترتب على كل منها.",
      "استعن بالمعلومات الموثوقة وبأهل الخبرة عند الحاجة.",
      "اختر خطوة عملية تتفق مع قيمك وظروفك.",
      "راجع النتيجة وتعلم منها دون القسوة على نفسك."
    ],
    question:"ما القيمة الأهم التي تريد الحفاظ عليها أثناء حل المشكلة؟"
  }
};

$("categories").addEventListener("click", event => {
  const button = event.target.closest("[data-key]");
  if (!button) return;

  selectedCategory = button.dataset.key;

  document.querySelectorAll(".category").forEach(item => {
    const active = item === button;
    item.classList.toggle("active", active);
    item.setAttribute("aria-pressed", String(active));
  });
});

$("startBtn").addEventListener("click", () => {
  $("formCard").scrollIntoView({behavior:"smooth", block:"start"});
  setTimeout(() => $("problem").focus({preventScroll:true}), 250);
});

$("exampleBtn").addEventListener("click", () => {
  selectedCategory = "innovation";
  document.querySelectorAll(".category").forEach(item => {
    const active = item.dataset.key === selectedCategory;
    item.classList.toggle("active", active);
    item.setAttribute("aria-pressed", String(active));
  });

  $("problem").value =
    "لدي فكرة تطبيق يساعد الناس على حل مشكلاتهم، لكنني لا أعرف كيف أبدأ أو أختبر الفكرة بميزانية محدودة.";
  $("goal").value = "إنشاء نموذج أولي وتجربته مع مستخدمين حقيقيين";
  $("deadline").value = "خلال أسبوع";
  $("constraints").value = "ميزانية محدودة وخبرة برمجية محدودة";
  $("status").textContent = "تم تحميل المثال. اضغط على إنشاء خطة الحل.";
  $("problem").focus();
});

$("clearBtn").addEventListener("click", () => {
  $("problemForm").reset();
  $("status").textContent = "";
  $("feedbackMessage").textContent = "";
  $("result").classList.remove("show");
  $("problem").focus();
});

$("problemForm").addEventListener("submit", event => {
  event.preventDefault();

  const problem = $("problem").value.trim();
  const goal = $("goal").value.trim();
  const deadline = $("deadline").value;
  const constraints = $("constraints").value.trim();

  if (!problem) {
    $("status").textContent = "من فضلك اكتب المشكلة أولًا.";
    $("problem").focus();
    return;
  }

  const plan = plans[selectedCategory];
  const intro = goal
    ? "هدفك المعلن: " + goal
    : "ابدأ بتوضيح النتيجة التي تريد الوصول إليها.";

  $("resultTitle").textContent = plan.title;
  $("summary").textContent =
    "المشكلة التي أدخلتها: " + problem + " " + intro;

  const steps = $("steps");
  steps.replaceChildren();

  const personalized = [...plan.steps];

  if (constraints) {
    personalized.push(
      "خذ القيد الذي ذكرته في الحسبان: " + constraints +
      ". عدّل الخطة حتى لا تتجاوز مواردك الحالية."
    );
  }

  personalized.push(
    "ضع موعد مراجعة خلال الفترة التي اخترتها: " + deadline + "."
  );

  personalized.forEach((text, index) => {
    const row = document.createElement("div");
    row.className = "step";

    const number = document.createElement("div");
    number.className = "number";
    number.textContent = String(index + 1);

    const paragraph = document.createElement("p");
    paragraph.textContent = text;

    row.append(number, paragraph);
    steps.appendChild(row);
  });

  $("followup").textContent = plan.question;
  $("nextStep").textContent =
    "خصص 15 دقيقة الآن لتحديد أول إجراء، ومن المسؤول عنه، ومتى ستنفذه.";

  lastPlan =
    "حلّ لي مشكلتي\n" +
    "المشكلة: " + problem + "\n" +
    "الهدف: " + (goal || "لم يحدد بعد") + "\n" +
    "الموعد: " + deadline + "\n" +
    "القيود: " + (constraints || "لم تذكر") + "\n\n" +
    "الخطة: " + plan.title + "\n" +
    personalized.map((item, i) => (i + 1) + ". " + item).join("\n") +
    "\n\nسؤال المتابعة: " + plan.question;

  $("feedbackMessage").textContent = "";
  $("result").classList.add("show");
  $("status").textContent = "تم إعداد الخطة المبدئية.";

  $("result").scrollIntoView({behavior:"smooth", block:"start"});
});

$("copyBtn").addEventListener("click", async () => {
  if (!lastPlan) return;

  try {
    await navigator.clipboard.writeText(lastPlan);
    $("status").textContent = "تم نسخ الخطة. يمكنك لصقها في ملاحظاتك.";
  } catch (error) {
    const area = document.createElement("textarea");
    area.value = lastPlan;
    area.setAttribute("readonly", "");
    area.style.position = "fixed";
    area.style.opacity = "0";
    document.body.appendChild(area);
    area.select();

    const copied = document.execCommand("copy");
    area.remove();

    $("status").textContent = copied
      ? "تم نسخ الخطة."
      : "تعذر النسخ التلقائي. يمكنك تحديد النص ونسخه يدويًا.";
  }
});

$("editBtn").addEventListener("click", () => {
  $("formCard").scrollIntoView({behavior:"smooth"});
  $("problem").focus({preventScroll:true});
});

$("newBtn").addEventListener("click", () => {
  $("problemForm").reset();
  $("result").classList.remove("show");
  $("status").textContent = "";
  $("feedbackMessage").textContent = "";
  $("problem").focus();
  $("formCard").scrollIntoView({behavior:"smooth"});
});

document.querySelectorAll("[data-feedback]").forEach(button => {
  button.addEventListener("click", () => {
    $("feedbackMessage").textContent =
      "شكرًا على رأيك: " + button.dataset.feedback +
      ". في هذه النسخة التجريبية لا يُرسل التقييم إلى خادم.";
  });
});
</script>
</body>
</html>
